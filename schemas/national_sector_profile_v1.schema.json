{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mangrove-intelligence.example/schemas/national_sector_profile_v1.schema.json",
  "title": "Bangladesh Industrial Intelligence National Sector Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "universe",
    "sector",
    "coverage",
    "composition",
    "concentration",
    "drilldown",
    "method"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string"
    },
    "universe": {
      "$ref": "national_dashboard_v1.schema.json#/properties/universe"
    },
    "sector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sector_family",
        "establishments",
        "share_national_pct",
        "district_count"
      ],
      "properties": {
        "sector_family": {
          "type": "string"
        },
        "establishments": {
          "type": "integer",
          "minimum": 1
        },
        "share_national_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "district_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coverage": {
      "type": "object"
    },
    "composition": {
      "type": "object"
    },
    "concentration": {
      "type": "object"
    },
    "drilldown": {
      "type": "object"
    },
    "method": {
      "type": "object"
    }
  }
}